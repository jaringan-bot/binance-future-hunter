# Files that are executed on Linux (scp'd to the VPS, run by systemd / bash)
# MUST keep LF endings regardless of the checkout platform. A `\r` in a
# `#!/usr/bin/env bash` shebang makes the interpreter lookup fail; systemd
# unit files and the gateway/proxy .mjs are shipped as-is to Linux too.
#
# (Deploy 2026-09-02: install.sh needed a manual `sed -i 's/\r$//'` on a
# Windows checkout before scp — this makes that unnecessary.)
*.sh            text eol=lf
*.service       text eol=lf
*.Caddyfile     text eol=lf
stream-gateway/**   text eol=lf
proxy-standalone/**  text eol=lf

# Migrations are applied by wrangler; keep them LF for clean remote diffs.
migrations/*.sql   text eol=lf
