# Template buat .dev.vars (local dev secrets, wrangler auto-load, JANGAN
# di-commit -- sudah di .gitignore). Copy file ini ke `.dev.vars`, isi
# value asli. Buat production, pakai `wrangler secret put <NAME>`, BUKAN
# file ini.

# WAJIB -- tanpa ini, semua tool "Binance native" gagal.
# Lihat README.md bagian "Setup Proxy Relay" (proxy-standalone/).
# Depth watch Task B (binance_watch_orderbook_realtime) pakai host +
# secret yang SAMA -- stream gateway ada di balik Caddy /stream/* yang sama.
PROXY_URL=
PROXY_SECRET=

# OPSIONAL -- proxy sekunder buat failover, lihat README.md bagian
# "Proxy sekunder / failover".
PROXY_URL_2=
PROXY_SECRET_2=

# OPSIONAL -- "true" buat matikan direct-to-Binance fallback (tier
# terakhir setelah primary & secondary gagal, default ON). Lihat
# README.md bagian "Direct fallback (tier terakhir, otomatis ON)".
DISABLE_DIRECT_FALLBACK=

# OPSIONAL -- aktifin GET /admin/usage (siapa yang connect ke worker ini).
# Tanpa ini, endpoint itu SELALU 403. Lihat README.md bagian
# "Admin: Usage Log".
ADMIN_SECRET=

# OPSIONAL -- comma-separated, origin browser TAMBAHAN yang diizinkan
# memanggil /mcp (default: https://claude.ai, https://claude.com). Lihat
# README.md bagian "Keamanan: DNS Rebinding Protection".
ALLOWED_ORIGINS=

# OPSIONAL -- token bot Telegram (dari @BotFather, format "123:ABC-...") +
# chat_id tujuan, buat entry alert (ENTRY_ALERT_CRON). Tanpa ini, alert
# di-skip + di-log doang (lihat src/telegram.ts), cron TETAP jalan normal.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OPSIONAL -- channel notifikasi tambahan (src/notify.ts). Kosong = channel
# itu di-skip; Telegram tetap default. Lihat README.md "Notifikasi
# Multi-Channel". DISCORD_WEBHOOK_URL = webhook Discord; NOTIFY_WEBHOOK_URL
# = endpoint generic yang nerima POST JSON {text}.
DISCORD_WEBHOOK_URL=
NOTIFY_WEBHOOK_URL=
