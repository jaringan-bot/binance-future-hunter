# Template buat .dev.vars (local dev secrets, wrangler auto-load, JANGAN
# di-commit -- sudah di .gitignore). Copy file ini ke `.dev.vars`, isi
# value asli. Buat production, pakai `wrangler secret put <NAME>`, BUKAN
# file ini.

# WAJIB -- tanpa ini, 34 dari 35 tool (semua "Binance native") gagal.
# Lihat README.md bagian "Setup Proxy Vercel".
PROXY_URL=
PROXY_SECRET=

# OPSIONAL -- proxy sekunder buat failover, lihat README.md bagian
# "Proxy sekunder / failover".
PROXY_URL_2=
PROXY_SECRET_2=

# OPSIONAL -- "true" buat matikan direct-to-Binance fallback (tier
# terakhir setelah primary & secondary gagal, default ON). Lihat
# README.md bagian "Direct fallback (tier terakhir, otomatis ON)".
DISABLE_DIRECT_FALLBACK=

# OPSIONAL -- cuma dipakai binance_get_liquidation_history (1 dari 35
# tool). Skip kalau gak butuh liquidation history. Lihat README.md
# bagian "Setup Coinalyze API Key".
COINALYZE_API_KEY=

# OPSIONAL -- aktifin GET /admin/usage (siapa yang connect ke worker ini).
# Tanpa ini, endpoint itu SELALU 403. Lihat README.md bagian
# "Admin: Usage Log".
ADMIN_SECRET=

# OPSIONAL -- comma-separated, origin browser TAMBAHAN yang diizinkan
# memanggil /mcp (default: https://claude.ai, https://claude.com). Lihat
# README.md bagian "Keamanan: DNS Rebinding Protection".
ALLOWED_ORIGINS=
